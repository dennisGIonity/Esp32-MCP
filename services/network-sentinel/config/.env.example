# Sentinel Environment Variables

# EskomSePush API Key (Free or Business Tier)
ESKOM_API_KEY=your_eskomsepush_api_key_here

# MikroTik Connection Settings
MIKROTIK_HOST=10.53.20.1
MIKROTIK_USER=sentinel_readonly
MIKROTIK_PASSWORD=CHANGE_ME_in_env
MIKROTIK_SNMP_COMMUNITY=public

# Sentinel Server Settings
SENTINEL_PORT=8000
SENTINEL_HOST=0.0.0.0
# Empty = open (lab). Set before this is reachable beyond the lab:
#   ADMIN  -> POST /api/telemetry/speedtest/run  (Authorization: Bearer <t>)
#   FEED   -> POST /api/telemetry/hardware-feed  (X-Fleet-Token from the ESP32 sentinel)
SENTINEL_ADMIN_TOKEN=
SENTINEL_FEED_TOKEN=
# Comma-separated browser origins allowed to call the API (default *)
SENTINEL_CORS_ORIGINS=*
MCP_SERVER_PORT=8001

# Geolocation API (Optional IPInfo / IP-API)
IPINFO_TOKEN=
