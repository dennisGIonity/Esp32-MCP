# AEDI - IONITY GLOBAL | ESP32-MCP fleet server env
# Copy to .env at the project root. All keys are IONITY_ prefixed.

IONITY_HOST=0.0.0.0
IONITY_PORT=8099
IONITY_FLEET_NAME=Ionity ESP32-MCP Fleet

# Ingest auth. Keep false until every node carries the token, then flip.
IONITY_FLEET_TOKEN=dev-fleet-token-change-me
IONITY_REQUIRE_TOKEN=false

# MQTT (primary transport)
IONITY_MQTT_ENABLED=true
IONITY_MQTT_HOST=127.0.0.1
IONITY_MQTT_PORT=1883
IONITY_MQTT_USERNAME=
IONITY_MQTT_PASSWORD=
IONITY_MQTT_ROOT=ionity

# Storage
IONITY_STORAGE_DRIVER=sqlite
IONITY_RETENTION_DAYS=30

# Health windows (seconds)
IONITY_STALE_AFTER_S=45
IONITY_OFFLINE_AFTER_S=135

# Alert thresholds
IONITY_ALERT_RSSI_DBM=-85
IONITY_ALERT_PACKET_LOSS_PCT=20
IONITY_ALERT_TEMP_C=80
IONITY_ALERT_FREE_HEAP_BYTES=20000
