# AEDI - IONITY GLOBAL | ESP32-MCP fleet server env
# Copy to .env at the project root. All keys are IONITY_ prefixed.

IONITY_HOST=0.0.0.0
IONITY_PORT=8099
IONITY_FLEET_NAME=Ionity ESP32-MCP Fleet

# Ingest auth. Keep false until every node carries the token, then flip.
IONITY_FLEET_TOKEN=dev-fleet-token-change-me
IONITY_REQUIRE_TOKEN=false

# MQTT (primary transport)
IONITY_MQTT_ENABLED=true
IONITY_MQTT_HOST=127.0.0.1
IONITY_MQTT_PORT=1883
IONITY_MQTT_USERNAME=
IONITY_MQTT_PASSWORD=
IONITY_MQTT_ROOT=ionity

# Storage
IONITY_STORAGE_DRIVER=sqlite
IONITY_RETENTION_DAYS=30

# Health windows (seconds)
IONITY_STALE_AFTER_S=45
IONITY_OFFLINE_AFTER_S=135

# Alert thresholds
IONITY_ALERT_RSSI_DBM=-85
IONITY_ALERT_PACKET_LOSS_PCT=20
IONITY_ALERT_TEMP_C=80
IONITY_ALERT_FREE_HEAP_BYTES=20000

# Operator token for commands (REST /cmd + MCP send_command). Empty = open (lab).
# Set it before the server is reachable from a network you don't control; the
# MCP bridge and the dashboard both pick it up (dashboard asks once).
IONITY_ADMIN_TOKEN=

# mDNS: the address boards are told to use. Empty = auto (routed LAN IP).
# If pinned to an address this host no longer has, the host falls back to auto and warns.
IONITY_MDNS_ADVERTISE_IP=
# Address the flasher pre-fills as "MCP host". Empty = same rule as above.
IONITY_PUBLIC_HOST=

# On-device MCP bridge: how long device_call_tool waits for a board (seconds)
IONITY_DEVICE_RPC_TIMEOUT_S=8

# Datadog (the host forwards metrics, events and service checks; boards never hold the key)
IONITY_DD_ENABLED=false
IONITY_DD_API_KEY=
IONITY_DD_SITE=datadoghq.com
IONITY_DD_ENV=lab
IONITY_DD_SERVICE=ionity-esp32-mcp
IONITY_DD_TAGS=
IONITY_DD_FLUSH_S=15
