# AEDI - IONITY GLOBAL | ESP32-MCP testers config  (copied to .env by SETUP.cmd)
# Policy 986 AED | (c) 2018-2026 Antwerp Designs | Ionity (Pty) Ltd
# Every server setting can be overridden here with the IONITY_ prefix.

IONITY_PORT=8099
IONITY_MQTT_HOST=127.0.0.1
IONITY_MQTT_PORT=1883

# LAN DNS logger. Port 53 needs the firewall open and nothing else on :53.
# Testers default to 5354 so it never clashes with Windows or mDNS (5353); set 53 to log a real LAN.
IONITY_DNS_PORT=5354

# Optional: require a token for device commands (reboot/ping/identify) and send_command.
# Leave empty on a private test bench. The dashboard asks for it once and remembers it.
IONITY_ADMIN_TOKEN=

# Optional: the IP boards should report to (blank = auto-detect this PC's LAN IP).
IONITY_PUBLIC_HOST=
IONITY_MDNS_ADVERTISE_IP=
