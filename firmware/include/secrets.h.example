// --- WiFi ------------------------------------------------------------------
#define WIFI_SSID           "YOUR_SSID"
#define WIFI_PASSWORD       "YOUR_WIFI_PASSWORD"

// --- MQTT broker credentials ----------------------------------------------
// Leave both empty strings for an anonymous/dev broker.
#define MQTT_USERNAME       "ionity_fleet"
#define MQTT_PASSWORD       "CHANGE_ME"

// --- Fleet enrolment token -------------------------------------------------
// Shared secret sent as X-Fleet-Token on HTTP ingest + in the MQTT connect
// payload. Rotate per deployment batch, not per device.
#define FLEET_TOKEN         "CHANGE_ME_FLEET_TOKEN"

// --- OTA password ----------------------------------------------------------
#define OTA_PASSWORD        "CHANGE_ME_OTA"
