# AEDI - IONITY GLOBAL | ESP32-MCP node firmware 3 | ESP32-S3 (primary target)
# Doc ID: DOC-2026-10-ESP32MCP-FW3 | Policy 986 AED | License AED 900
#
# PSRAM: octal (N8R8 / N16R8 modules, the ESP-DL boards). IGNORE_NOTFOUND keeps a
# board without (or with quad) PSRAM running on internal RAM: HELLO then says psramMb 0.
# For quad-PSRAM modules (N4R2, N8R2) replace MODE_OCT with CONFIG_SPIRAM_MODE_QUAD=y.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_MQTT_OUTBOX_DATA_ON_EXTERNAL_MEMORY=y

# Core 0 = network (Wi-Fi, lwIP, esp-mqtt, net_task); Core 1 = mcp_worker.
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
